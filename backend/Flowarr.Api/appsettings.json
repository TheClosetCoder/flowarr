{
  "ConnectionStrings": {
    "Flowarr": "Host=localhost;Port=5432;Database=flowarr;Username=flowarr;Password=flowarr"
  },
  "Flowarr": {
    "QBittorrent": {
      "BaseUrl": "",
      "Username": "",
      "Password": ""
    },
    "Radarr": {
      "BaseUrl": "",
      "ApiKey": ""
    },
    "Storage": {
      "LocalPath": "/media",
