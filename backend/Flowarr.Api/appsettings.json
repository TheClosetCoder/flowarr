      "Username": "",
      "Password": "",
      "PrivateKeyPath": "",
      "RemoteRootPath": ""
    },
    "Security": {
      "DataProtectionKeysPath": "/var/lib/flowarr/keys"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
